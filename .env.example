# ─────────────────────────────────────────────────────────────────────────────
# The repo's only env file. Copy it to `.env` at the repo root (or run
# scripts/setup-dev.sh, which fills in real secrets) — every workspace reads
# that one file: backend and TS packages, the frontend, the Drizzle CLI and the
# compose files. A variable already set in the shell wins over this file.
#
# Uncommented lines are what local dev needs; commented ones are optional and
# show their default. A production deployment gets its own `.env`, written by
# scripts/bootstrap.sh in the deployment directory.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# "development" | "production" | "test". Production switches logs to JSON
# lines. The compose files set it themselves.
NODE_ENV=development

# Minimum log severity: "fatal" | "error" | "warn" | "info" | "debug" | "trace".
# LOG_LEVEL=info

# Skips the zod env validation of packages/env (builds and CLI tasks only).
# SKIP_ENV_VALIDATION=1

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL for the backend (Drizzle). Required. Local dev: the compose.dev.yml
# database (`bun run postgres:start` publishes it on localhost:5432 for native
# dev; `bun run dev` runs its own `db` and overrides this to reach it).
# POSTGRES_PASSWORD (below) sets its password; it defaults to postgres.
DATABASE_URL=postgresql://postgres:postgres@db:5432/stack
# Host port `bun run postgres:start` publishes it on. Change it (and the port
# in DATABASE_URL) when 5432 is already taken on this machine. Default 5432.
# POSTGRES_PORT=5432

# ── Auth ─────────────────────────────────────────────────────────────────────
# Better Auth's base URL. Required. Use the public origin the browser sees
# (same as CORS_ORIGIN), not the backend's own port: OAuth/OIDC callbacks are
# built from it. Local dev: the dev gateway's HTTPS site (HTTP/2, local CA;
# see `bun run dev:cert`), which routes /api/* to the backend.
BETTER_AUTH_URL=https://localhost:4321

# Signs sessions and cookies. Required, at least 32 characters:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# Public origin the browser uses (a single URL): CORS and Better Auth's trusted
# origin. Required. Local dev: the dev gateway's HTTPS site.
CORS_ORIGIN=https://localhost:4321

# Admin created on backend boot when all three are set (idempotent by email).
# Code-declared cron jobs run as this user.
# ADMIN_EMAIL=admin@stack.local
# ADMIN_PASSWORD=change-me-min-8-chars
# ADMIN_NAME=Admin

# Generic OIDC sign-in provider; enabled only when all three are set.
# OIDC_DISCOVERY_URL is the issuer's base URL: the backend appends
# /.well-known/openid-configuration itself.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=https://idp.example.com

# ── Services ─────────────────────────────────────────────────────────────────
# Where the frontend reaches the backend over HTTP: SSR session lookups and the
# Astro dev server's proxy for /rpc, /api, /scalar and /openapi.json.
BACKEND_URL=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# Loki endpoint for the activity log (/admin/logs): backend API calls and
# frontend page views. Unset keeps logs on the console only. Local dev: the
# compose.dev.yml `loki` service (`bun run dev`, or `bun run loki:start`).
LOKI_URL=http://localhost:3100

# ── Tracing (OpenTelemetry) ──────────────────────────────────────────────────
# OTLP/HTTP endpoint the backend and the frontend's SSR server export spans to
# (`/v1/traces` is appended). Unset turns tracing off: nothing is traced or
# exported. Local dev: the compose.dev.yml `tempo` service (`bun run dev`, or
# `bun run tempo:start`).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Probability (0 to 1) that a new trace is kept. Default 1.
# OTEL_TRACES_SAMPLER_ARG=1
# Tempo's query API, read by the backend for the trace viewer (/admin/traces).
# Unset leaves the viewer empty.
TEMPO_URL=http://localhost:3200

# ── Web client env (packages/env/src/web.ts) ─────────────────────────────────
# Validated by @nonete/env/web, which nothing imports today.
# PUBLIC_SERVER_URL=https://localhost:4321

# ── Gateway (apps/gateway/Caddyfile) ─────────────────────────────────────────
# Set by the compose files; the defaults are the Docker service addresses.
# GATEWAY_HTTP_PORT=80
# BACKEND_HTTP_UPSTREAM=backend:3000
# FRONTEND_HTTP_UPSTREAM=frontend:4321

# ── Compose database and published port ──────────────────────────────────────
# Password of the compose `db` service: required by compose.prod.yml (written
# by scripts/bootstrap.sh); compose.yml and compose.dev.yml default to
# `postgres`, the password in DATABASE_URL above.
# POSTGRES_PASSWORD=
# Host port the production gateway publishes (compose.yml, compose.prod.yml).
# FRONTEND_PORT=4444
