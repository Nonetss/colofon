---
import { textVariants } from "@/components/shared/brand/typography"
import { renderBlocks } from "@/features/docs/page/model/render"
import type { DocsPage } from "@/features/docs/page/model/types"
import { getIcon } from "@/lib/icon-registry"

interface Props {
  page: DocsPage
}

const { page } = Astro.props
const blocks = page.tree === null ? [] : renderBlocks(page.tree)
const unreadable = page.source === "file" && page.tree === null
const notice =
  "mt-6 flex flex-col gap-2 rounded-lg border border-destructive/30 bg-destructive/5 px-4 py-3"
---

{page.problems.length > 0 && (
  <section class={notice} aria-label="Problemas de la ficha" data-md-skip>
    <p class={textVariants({ role: "label", tone: "destructive" })}>
      Problemas de esta ficha · solo lo ven los administradores
    </p>
    <ul class:list={["flex flex-col gap-1", textVariants({ role: "meta" })]}>
      {page.problems.map((problem) => (
        <li>
          <span class={textVariants({ role: "data", tone: "muted" })}>
            {problem.file}
            {problem.line !== null && `:${problem.line}`}
          </span>{" "}
          {problem.message}
        </li>
      ))}
    </ul>
  </section>
)}

{unreadable ? (
  <p class:list={[notice, textVariants({ role: "meta" })]}>
    Esta ficha no se puede mostrar: su contenido tiene un error.
  </p>
) : (
  blocks.length > 0 && (
    <div class="typeset typeset-docs doc mt-6">
      {blocks.map((block) => {
        if (block.kind === null) return <Fragment set:html={block.html} />
        const Icon = getIcon("docSections", block.kind)
        return (
          <section class="doc-section" data-kind={block.kind}>
            <span class="doc-section-badge" aria-hidden="true">
              <Icon className="size-4.5" />
            </span>
            <Fragment set:html={block.html} />
          </section>
        )
      })}
    </div>
  )
)}
