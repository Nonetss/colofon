---
import { textVariants } from "@/components/shared/brand/typography"
import type { DocsPage } from "@/features/docs/page/model/types"
import { getIcon } from "@/lib/icon-registry"

interface Props {
  page: DocsPage
}

const { page } = Astro.props
const ChevronRight = getIcon("controls", "chevronRight")
---

{page.children.length > 0 && (
  <section
    class="@container mt-12 flex flex-col gap-3"
    aria-labelledby="fichas"
  >
    <h2 id="fichas" class={textVariants({ role: "label", tone: "muted" })}>
      {page.path === "" ? "Secciones" : `En ${page.header.title}`}
    </h2>
    <ul class="grid grid-cols-1 gap-3 @xl:grid-cols-2">
      {page.children.map((child) => (
        <li class="flex">
          <a
            href={child.href}
            class="group flex min-w-0 flex-1 items-start gap-2.5 rounded-xl border bg-card/40 p-4 transition-colors duration-200 hover:border-foreground/15 hover:bg-muted/40"
          >
            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <span
                class:list={[textVariants({ role: "headline" }), "truncate"]}
              >
                {child.title}
              </span>
              {child.description && (
                <span
                  class:list={[
                    textVariants({ role: "meta", tone: "muted" }),
                    "line-clamp-2 leading-relaxed",
                  ]}
                >
                  {child.description}
                </span>
              )}
            </span>
            <ChevronRight
              aria-hidden
              className="size-4 shrink-0 text-muted-foreground transition-[color,transform] group-hover:translate-x-0.5 group-hover:text-foreground"
            />
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
