---
import { surfaceVariants } from "@/components/shared/brand/surface"
import { textVariants } from "@/components/shared/brand/typography"
import type { DocsPage } from "@/features/docs/page/model/types"
import { getIcon } from "@/lib/icon-registry"

interface Props {
  page: DocsPage
}

const { previous, next } = Astro.props.page
const BackIcon = getIcon("navigation", "back")
const ForwardIcon = getIcon("navigation", "forward")
const card = [
  "group flex min-w-0 flex-col gap-1 p-4",
  surfaceVariants({ interactive: true }),
]
const eyebrow = textVariants({ role: "status", tone: "muted" })
const title = textVariants({ role: "headline" })
---

{(previous || next) && (
  <div class="@container mt-12">
    <nav
      aria-label="Anterior y siguiente"
      class="grid grid-cols-1 gap-3 @md:grid-cols-2"
      data-md-skip
    >
      {previous ? (
        <a href={previous.href} rel="prev" class:list={card}>
          <span class:list={["inline-flex items-center gap-1.5", eyebrow]}>
            <BackIcon
              aria-hidden
              className="size-3 transition-transform group-hover:-translate-x-0.5"
            />
            Anterior
          </span>
          <span class:list={[title, "truncate"]}>{previous.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a
          href={next.href}
          rel="next"
          class:list={[card, "@md:items-end @md:text-right"]}
        >
          <span class:list={["inline-flex items-center gap-1.5", eyebrow]}>
            Siguiente
            <ForwardIcon
              aria-hidden
              className="size-3 transition-transform group-hover:translate-x-0.5"
            />
          </span>
          <span class:list={[title, "max-w-full truncate"]}>{next.title}</span>
        </a>
      )}
    </nav>
  </div>
)}
