---
import { textVariants } from "@/components/shared/brand/typography"
import {
  cardBlocks,
  DocCard,
  type DocsNav,
  pagesMeta,
} from "@/features/docs/shared"

interface Props {
  nav: DocsNav
  isAdmin: boolean
}

// The "Todos" home: every repository as a block headed by its name and
// description, its top-level sections as cards that come in one after
// another; with a menu, the cards of each group under its title.
const { nav, isAdmin } = Astro.props
const muted = textVariants({ role: "meta", tone: "muted" })
const label = textVariants({ role: "label", tone: "muted" })

/** The top-level entries, counting each group's entries instead of it. */
function sectionCount(nodes: DocsNav["repositories"][number]["nodes"]): number {
  return cardBlocks(nodes).reduce(
    (total, block) => total + block.links.length,
    0
  )
}

/** "3 secciones" under a repository's name. */
function sectionsLabel(count: number): string {
  if (count === 1) return "1 sección"
  return `${count} secciones`
}
---

<header class="flex flex-col gap-2 border-b pb-6">
  <h1 class:list={[textVariants({ role: "display" }), "text-balance"]}>
    Documentación
  </h1>
  <p class:list={[muted, "max-w-3xl"]}>
    Todos los repositorios de documentación de la plataforma.
  </p>
</header>

{nav.repositories.length === 0 ? (
  <section class="mt-8 flex flex-col gap-3">
    <p class={textVariants({ role: "body" })}>Aún no hay documentación.</p>
    {isAdmin ? (
      <p class={muted}>
        Añade un repositorio de contenido en{" "}
        <a
          href="/admin/content"
          class="text-primary underline-offset-4 hover:underline"
        >
          Administración · Contenido
        </a>
        .
      </p>
    ) : (
      <p class={muted}>
        Cuando un administrador conecte un repositorio aparecerá aquí.
      </p>
    )}
  </section>
) : (
  <div class="mt-8 flex flex-col gap-10">
    {nav.repositories.map((repository, repositoryIndex) => (
      <section
        class="@container flex flex-col gap-3"
        aria-labelledby={`repo-${repository.slug}`}
      >
        <div class="flex flex-wrap items-end justify-between gap-x-3 gap-y-1">
          <div class="min-w-0">
            <h2 id={`repo-${repository.slug}`} class={label}>
              <a
                href={`/${repository.slug}`}
                class="transition-colors hover:text-foreground"
              >
                {repository.name}
              </a>
            </h2>
            {repository.description && (
              <p class:list={[muted, "mt-1 max-w-3xl"]}>
                {repository.description}
              </p>
            )}
          </div>
          {repository.available && (
            <span class={textVariants({ role: "data", tone: "muted" })}>
              {sectionsLabel(sectionCount(repository.nodes))}
            </span>
          )}
        </div>
        {repository.available ? (
          cardBlocks(repository.nodes).map((block) => (
            <div class="flex flex-col gap-2">
              {block.group && (
                <div class="mt-2 flex flex-col gap-0.5">
                  <h3 class={textVariants({ role: "title" })}>
                    {block.group.title}
                  </h3>
                  {block.group.description && (
                    <p class={muted}>{block.group.description}</p>
                  )}
                </div>
              )}
              <ul class="grid grid-cols-1 gap-3 @xl:grid-cols-2 @4xl:grid-cols-3">
                {block.links.map((node, index) => (
                  <li class="flex">
                    <DocCard
                      href={node.href}
                      title={node.title}
                      description={node.description}
                      icon={node.icon}
                      meta={pagesMeta(node)}
                      delay={Math.min(repositoryIndex * 30 + index * 40, 400)}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))
        ) : (
          <p class={muted}>Sin contenido todavía.</p>
        )}
      </section>
    ))}
  </div>
)}
