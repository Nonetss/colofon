---
import {
  DocBody,
  DocChildren,
  DocHero,
  DocPager,
  DocToc,
} from "@/features/docs/page"
import {
  ALL_SCOPE,
  DOCS_SCOPE_COOKIE,
  isGoneRepository,
  isMissing,
  SCOPE_COOKIE_MAX_AGE,
  scopeToStore,
} from "@/features/docs/shared"
import Docs from "@/layouts/Docs.astro"
import { createServerClient } from "@/lib/orpc-server"

// A page of a content repository: `/<slug>` is its home and `/<slug>/<path>`
// a page or section. Rendered on the server from the backend's tree, so the
// text is in the HTML; an unknown page is the 404 page, and a repository that
// no longer exists (deleted, or not shared any more) sends the reader to `/`,
// where all of them are, instead of to a dead end.

/** The scope the sidebar starts with: the one just stored, or the old one. */
function scopeNow(
  store: string | undefined,
  stored: string | undefined
): string | undefined {
  if (store !== undefined) return store
  return stored
}

const client = createServerClient(Astro.request)
const repository = Astro.params.repo ?? ""
const path = Astro.params.path ?? ""

const [nav, page] = await Promise.all([
  client.v1.docs.nav(),
  client.v1.docs.page({ repository, path }).catch((error: unknown) => {
    if (isMissing(error)) return undefined
    throw error
  }),
])
const slugs = nav.repositories.map((entry) => entry.slug)
if (page === undefined && isGoneRepository(repository, slugs)) {
  // `/` already ignores a remembered repository that is gone; the cookie goes
  // too so the sidebar doesn't start from it.
  if (Astro.cookies.get(DOCS_SCOPE_COOKIE)?.value === repository) {
    Astro.cookies.set(DOCS_SCOPE_COOKIE, ALL_SCOPE, {
      path: "/",
      maxAge: SCOPE_COOKIE_MAX_AGE,
      sameSite: "lax",
    })
  }
  return Astro.redirect("/")
}
if (page === undefined) return Astro.rewrite("/404")

const stored = Astro.cookies.get(DOCS_SCOPE_COOKIE)?.value
const store = scopeToStore(stored, slugs, page.repository.slug)
if (store !== undefined) {
  Astro.cookies.set(DOCS_SCOPE_COOKIE, store, {
    path: "/",
    maxAge: SCOPE_COOKIE_MAX_AGE,
    sameSite: "lax",
  })
}
const scope = scopeNow(store, stored)
const title = `${page.header.title} · ${page.repository.name}`
---

<Docs title={title} nav={nav} storedScope={scope} styles={page.styles}>
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href={`${page.href}/llm.txt`}
  >
  <DocHero page={page} />
  <DocBody page={page} />
  <DocChildren page={page} />
  <DocPager page={page} />
  <DocToc slot="aside" page={page} />
</Docs>
