---
import { textVariants } from "@/components/shared/brand/typography"
import Layout from "@/layouts/Layout.astro"
import { appSurfaces } from "@/lib/app-surfaces"
import { getIcon } from "@/lib/icon-registry"

const ArrowLeft = getIcon("navigation", "back")
---

<Layout title={appSurfaces["not-found"].title}>
  <main
    class="mx-auto flex min-h-main w-full max-w-3xl flex-col justify-center px-4 py-24 sm:px-6"
  >
    <h1 class={textVariants({ role: "display" })}>Esta página no existe</h1>
    <p
      class:list={[
        "mt-2 max-w-prose text-pretty",
        textVariants({ role: "body", tone: "muted" }),
      ]}
    >
      <span class={textVariants({ role: "data" })}>Error 404</span>
      <span class="mx-1.5 text-border" aria-hidden="true">·</span>
      El enlace que has seguido está roto o el contenido se ha movido.
    </p>
    <a
      href="/"
      class:list={[
        "mt-6 -ml-1 inline-flex w-fit items-center gap-1 transition-colors hover:text-foreground",
        textVariants({ role: "status", tone: "muted" }),
      ]}
    >
      <ArrowLeft className="size-3" aria-hidden="true" />
      Volver al inicio
    </a>
  </main>
</Layout>
