---
import { ProfileAccountPage } from "@/features/profile/account"
import WithSidebar from "@/layouts/WithSidebar.astro"
import { appSurfaces } from "@/lib/app-surfaces"

const { user, session } = Astro.locals

if (!user || !session) return Astro.redirect("/login")
---

<WithSidebar title={appSurfaces.profile.title} section="profile">
  <ProfileAccountPage user={user} session={session} client:only="react" />
</WithSidebar>
