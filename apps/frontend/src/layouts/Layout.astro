---
import "@/styles/global.css"
import { ClientRouter, fade } from "astro:transitions"
import { ScrollToTopButton } from "@/components/shared/layout/scroll-to-top-button"
import { Toaster } from "@/components/ui/sonner"
import { NavbarAuthenticated } from "@/features/app-shell/authenticated"
import { NavbarGuest, SiteFooter } from "@/features/app-shell/guest"
import FontPreload from "@/layouts/font-preload.astro"
import ServiceWorker from "@/layouts/service-worker.astro"
import { isAdminUser } from "@/lib/auth"

interface Props {
  title: string
  guestNavbar?: boolean
  hideFooter?: boolean
  /**
   * Let the slot fill the viewport (including under the fixed navbar)
   * so an inner scroller can paint through `backdrop-blur`. Pair with
   * `hideFooter`. Without this, the slot is padded below the navbar.
   */
  overlayNavbar?: boolean
  /** Fade the layout slot. `Docs` opts out and fades only the page. */
  animateContent?: boolean
  /**
   * `false` leaves out the site footer while the window still scrolls (the
   * documentation reader). `hideFooter` also locks the page to the viewport.
   */
  footer?: boolean
  /**
   * Extra attributes for `<body>`. The router swaps `<body>` with each page,
   * so they follow client-side navigation (`Docs` marks pages that have the
   * documentation sidebar).
   */
  bodyAttributes?: Record<string, string>
  /**
   * Shows the floating "back to top" button (mounted once below) once the
   * page scrolls past its threshold, by stamping `data-scroll-to-top` on the
   * swapped content so the marker follows client-side navigation.
   */
  scrollToTop?: boolean
}

const {
  title,
  guestNavbar = false,
  hideFooter = false,
  overlayNavbar = false,
  animateContent = true,
  footer = true,
  bodyAttributes = {},
  scrollToTop = false,
} = Astro.props
const scrollUnderNavbar = hideFooter && overlayNavbar

const { user, session } = Astro.locals
const hasSession = !!user && !!session

const isAdmin = isAdminUser(user)
---

<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    >
    <title>{title}</title>
    <FontPreload />
    <ClientRouter />
    <script is:inline>
    function applyTheme(doc) {
      const stored = localStorage.getItem("theme")
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches
      const theme =
        stored === "light" || stored === "dark"
          ? stored
          : prefersDark
            ? "dark"
            : "light"
      doc.documentElement.classList.toggle("dark", theme === "dark")
    }
    // The reader's page width ("Ancho completo"), set before painting like
    // the theme so a full-width page doesn't open narrow and then jump.
    function applyReadingWidth(doc) {
      let full = false
      try {
        full = localStorage.getItem("docs-width") === "full"
      } catch {}
      doc.documentElement.toggleAttribute("data-reading-width-full", full)
    }
    applyTheme(document)
    applyReadingWidth(document)
    document.addEventListener("astro:before-swap", (event) => {
      applyTheme(event.newDocument)
      applyReadingWidth(event.newDocument)
    })
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => applyTheme(document))
    </script>
    <link rel="icon" href="/logo.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#262624">
    <ServiceWorker />
  </head>
  <body
    {...bodyAttributes}
    class:list={[
      "flex flex-col",
      hideFooter ? "h-dvh overflow-hidden" : "min-h-screen",
    ]}
  >
    {guestNavbar || !hasSession ? (
      <NavbarGuest
        client:only="react"
        transition:persist="navbar-guest"
        nameApp="DOC"
      />
    ) : (
      <NavbarAuthenticated
        client:only="react"
        transition:persist="navbar-auth"
        user={user}
        nameApp="DOC"
        isAdmin={isAdmin}
      />
    )}
    <div
      class:list={[
        "flex flex-1 flex-col",
        // Fill the viewport (the navbar padding included) so the footer
        // always sits below the fold, even on short pages.
        hideFooter ? "min-h-0 overflow-hidden" : "min-h-svh",
        scrollUnderNavbar
          ? "*:flex *:h-full *:min-h-0 *:flex-col"
          : "pt-(--navbar-height)",
      ]}
      transition:animate={animateContent ? fade({ duration: "0.2s" }) : "none"}
      data-scroll-to-top={scrollToTop ? "" : undefined}
    >
      <slot />
    </div>
    {!hideFooter && footer ? <SiteFooter /> : null}
    <Toaster client:only="react" />
    <div class="scroll-to-top-root" transition:persist="scroll-to-top">
      <ScrollToTopButton client:only="react" />
    </div>
  </body>
</html>
