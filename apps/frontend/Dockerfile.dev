# Keep in sync with "packageManager" in the root package.json.
ARG BUN_VERSION=1.4.2

# Dev image for compose.dev.yml: runs the app's own hot-reload server from
# source. Edits reach the container through `docker compose watch` (sync), so
# the repo is never bind-mounted and node_modules stays the container's own.
FROM oven/bun:${BUN_VERSION}-slim
WORKDIR /app

# Same manifest-first install layer as the production Dockerfile: it stays
# cached until a package.json or the lockfile changes (watch rebuilds then).
COPY package.json bun.lock bunfig.toml ./
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
COPY apps/site/package.json apps/site/
COPY packages/api/package.json packages/api/
COPY packages/auth/package.json packages/auth/
COPY packages/config/package.json packages/config/
COPY packages/content/package.json packages/content/
COPY packages/cron/package.json packages/cron/
COPY packages/db/package.json packages/db/
COPY packages/env/package.json packages/env/
COPY packages/logger/package.json packages/logger/
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile

COPY . .

EXPOSE 4320

WORKDIR /app/apps/frontend
# Same port as native `astro dev` (:4320, from the `dev` script), on all
# interfaces so the dev gateway reaches it over the compose network; only
# the gateway publishes a port (https://localhost:4321)
CMD ["bun", "run", "dev", "--host", "0.0.0.0"]
