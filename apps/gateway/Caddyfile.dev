# Dev gateway (compose.dev.yml and apps/gateway/compose.yml). Never used by
# the production image's command.
#
# https://localhost:4321 is the dev URL and the only port dev publishes: TLS
# from Caddy's local CA and HTTP/2, which browsers only speak over TLS, so the
# hundreds of unbundled modules Vite serves in dev share one connection
# instead of six. `astro dev` listens behind it on :4320 (Vite drops HTTP/2
# when its proxy is on, so it can't do this itself).
#
# The CA lives in /data (the gateway_data volume); `bun run dev:cert` exports
# its root for the browser to trust.
{
	admin off
	# Caddy names every local CA "Caddy Local Authority - <year> ECC Root", so
	# a browser that already trusts another project's CA picks that one by
	# subject and fails with SEC_ERROR_BAD_SIGNATURE. Names only apply when the
	# CA is generated: an existing one keeps its old name until
	# /data/caddy/pki/authorities/local is removed.
	pki {
		ca local {
			name "colofon dev"
			root_cn "colofon dev Local Root"
			intermediate_cn "colofon dev Local Intermediate"
		}
	}
	# No HTTP site: never bind :80 for HTTP→HTTPS redirects
	auto_https disable_redirects
	# The container can't reach the host's trust store
	skip_install_trust
	servers {
		protocols h1 h2
		# Plain HTTP on :4321 (http://localhost:4321) gets a redirect to
		# https on the same port instead of Go's "Client sent an HTTP request
		# to an HTTPS server". http_redirect must come before tls.
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

https://localhost:4321 {
	tls internal
	import routes.caddy
}
