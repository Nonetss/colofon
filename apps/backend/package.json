{
  "name": "backend",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@nonete/api": "workspace:*",
    "@nonete/auth": "workspace:*",
    "@nonete/cron": "workspace:*",
    "@nonete/db": "workspace:*",
    "@nonete/env": "workspace:*",
    "@nonete/logger": "workspace:*",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/pino": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nonete/config": "workspace:*",
    "@types/bun": "catalog:",
    "pino-pretty": "catalog:",
    "tsdown": "^0.23.1",
    "typescript": "catalog:"
  }
}
