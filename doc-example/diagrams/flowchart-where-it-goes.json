{
  "type": "flowchart",
  "title": "Dónde va cada cosa",
  "desc": "Qué preguntarse ante algo que contar: si se repite con los mismos campos es una entidad del catálogo; si cuenta cómo se conectan las piezas, un diagrama; si no, una página",
  "steps": [
    { "id": "start", "name": "Tengo algo que contar", "kind": "start" },
    {
      "id": "repeats",
      "name": "¿Se repite con los mismos campos?",
      "kind": "decision"
    },
    {
      "id": "entity",
      "entity": "files/entity",
      "sub": "catalog/<tipo>/<id>.yaml",
      "info": "Una ficha por cosa: la plataforma la valida contra su tipo y la muestra en tablas"
    },
    { "id": "connects", "name": "¿Cuenta cómo se conectan?", "kind": "decision" },
    {
      "id": "diagram",
      "entity": "files/diagram-file",
      "sub": "diagrams/<id>.json",
      "focal": true
    },
    { "id": "page", "entity": "files/page", "sub": "docs/**/*.mdx" }
  ],
  "links": [
    { "from": "start", "to": "repeats" },
    { "from": "repeats", "to": "entity", "label": "SÍ" },
    { "from": "repeats", "to": "connects", "label": "NO" },
    { "from": "connects", "to": "diagram", "label": "SÍ", "kind": "accent" },
    { "from": "connects", "to": "page", "label": "NO" }
  ]
}
