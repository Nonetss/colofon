{
  "name": "stack",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.7",
      "zod": "^4.6.7",
      "typescript": "^6",
      "@types/bun": "^1.4.3",
      "hono": "^4.13.13",
      "@orpc/server": "2.0.0-beta.42",
      "@orpc/contract": "2.0.0-beta.42",
      "@orpc/openapi": "2.0.0-beta.42",
      "@orpc/zod": "2.0.0-beta.42",
      "@orpc/json-schema": "2.0.0-beta.42",
      "better-auth": "1.7.7",
      "@better-auth/api-key": "1.7.7",
      "@better-auth/core": "1.7.7",
      "@orpc/client": "2.0.0-beta.42",
      "@orpc/tanstack-query": "2.0.0-beta.42",
      "@orpc/pino": "2.0.0-beta.42",
      "@orpc/publisher": "2.0.0-beta.42",
      "pino": "^10.4.0",
      "pino-pretty": "^13.2.0",
      "drizzle-orm": "^1.0.0-rc.4",
      "pg": "^8.23.1",
      "@types/pg": "^8.23.1",
      "astro": "7.3.8",
      "@astrojs/check": "0.9.10",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@fontsource-variable/space-grotesk": "^5.3.0",
      "@fontsource/space-mono": "^5.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "docker compose -f compose.dev.yml up --build --watch",
    "dev:down": "docker compose -f compose.dev.yml down",
    "dev:local": "turbo watch dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "format": "biome check --write --linter-enabled=false .",
    "dev:frontend": "turbo watch -F frontend dev",
    "dev:backend": "turbo watch -F backend dev",
    "icons:catalog": "cd apps/frontend && bun scripts/generate-icon-catalog.ts",
    "gateway": "docker compose -f apps/gateway/compose.yml up --build",
    "dev:cert": "docker run --rm -v stack-dev_gateway_data:/data:ro caddy:2-alpine cat /data/caddy/pki/authorities/local/root.crt > caddy-local-root.crt && echo 'Exported caddy-local-root.crt: import it in the browser as a trusted certificate authority'",
    "db:push": "turbo -F @nonete/db db:push",
    "db:studio": "turbo -F @nonete/db db:studio",
    "db:generate": "turbo -F @nonete/db db:generate",
    "db:migrate": "turbo -F @nonete/db db:migrate",
    "loki:start": "docker compose -f compose.dev.yml --profile native up -d loki-native",
    "loki:stop": "docker compose -f compose.dev.yml --profile native stop loki-native",
    "setup:dev": "bash scripts/setup-dev.sh",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "biome check --write .",
    "test": "turbo test --log-order=grouped --ui=stream",
    "tailwind:check": "cd apps/frontend && tailwint",
    "tailwind:fix": "cd apps/frontend && tailwint --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nonete/config": "workspace:*",
    "@types/bun": "catalog:",
    "tailwint": "^1.1.16",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "@better-auth/core": "1.7.7"
  }
}
