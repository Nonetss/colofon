{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env*"],
      "outputs": ["dist/**", ".astro/**"],
      "env": ["PUBLIC_SERVER_URL", "NODE_ENV", "SKIP_ENV_VALIDATION"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist/**", "*.tsbuildinfo", ".astro/**"]
    },
    "@nonete/api#build": {
      "outputs": []
    },
    "@nonete/auth#build": {
      "outputs": []
    },
    "@nonete/content#build": {
      "outputs": []
    },
    "@nonete/cron#build": {
      "outputs": []
    },
    "@nonete/db#build": {
      "outputs": []
    },
    "@nonete/env#build": {
      "outputs": []
    },
    "@nonete/logger#build": {
      "outputs": []
    },
    "@nonete/telemetry#build": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "inputs": ["package.json", "$TURBO_ROOT$/.env*"],
      "cache": false,
      "persistent": true,
      "interruptible": false
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:custom": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN",
        "NODE_ENV",
        "SKIP_ENV_VALIDATION",
        "LOG_LEVEL"
      ]
    }
  }
}
