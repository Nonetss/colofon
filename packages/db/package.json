{
  "name": "@nonete/db",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#schema": "./src/schema/index.ts",
    "#schema/*": "./src/schema/*/index.ts",
    "#seed": "./src/seed/index.ts",
    "#seed/*": "./src/seed/*.ts",
    "#testing/*": "./testing/*.ts",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./testing": {
      "default": "./testing/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./seed": {
      "default": "./src/seed/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./schema/*": {
      "default": "./src/schema/*/index.ts"
    }
  },
  "scripts": {
    "build": "true",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "check-types": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@nonete/env": "workspace:*",
    "@nonete/logger": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@nonete/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "catalog:"
  }
}
